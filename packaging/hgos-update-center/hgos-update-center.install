_refresh() {
  update-desktop-database -q /usr/share/applications 2>/dev/null || true
  update-mime-database /usr/share/mime >/dev/null 2>&1 || true
  gtk-update-icon-cache -q -t -f /usr/share/icons/hicolor 2>/dev/null || true
}
post_install() {
  _refresh
  # Taskleistensymbol für alle Benutzer beim Login starten.
  systemctl --global disable arch-update-tray.service >/dev/null 2>&1 || true
  systemctl --global enable org.cachyos.updater-tray.service >/dev/null 2>&1 || true
}
post_upgrade() {
  post_install
}
pre_remove() {
  systemctl --global disable org.cachyos.updater-tray.service >/dev/null 2>&1 || true
  systemctl --global disable org.cachyos.updater-check.timer >/dev/null 2>&1 || true
}
post_remove() {
  _refresh
}
