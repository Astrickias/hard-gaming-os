[Trigger]
Operation = Install
Operation = Upgrade
Type = Package
Target = filesystem
Target = lsb-release
Target = grub
Target = grub-btrfs
Target = plymouth
Target = cachyos-hooks
Target = cachyos-settings
Target = systemd-boot-manager

[Action]
Description = Hard Gaming OS: Branding wiederherstellen
When = PostTransaction
Exec = /usr/lib/hard-gaming-os/apply-branding
