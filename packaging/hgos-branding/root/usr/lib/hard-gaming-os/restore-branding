#!/usr/bin/env bash
# Hard Gaming OS – gesicherte Originaldateien zurückspielen (beim Entfernen von hgos-branding).
set -euo pipefail
backup=/var/lib/hard-gaming-os/backup
[[ -e $backup/.complete ]] || { echo 'Hard Gaming OS: keine Sicherung vorhanden, nichts wiederherzustellen'; exit 0; }
while IFS= read -r -d '' saved; do
  file="${saved#"$backup"}"
  install -d "$(dirname "$file")"
  rm -f -- "$file"
  cp -a "$saved" "$file"
done < <(find "$backup" -mindepth 2 \( -type f -o -type l \) -print0)
if [[ -f $backup/.missing ]]; then
  while IFS= read -r file; do [[ -n $file ]] && rm -f -- "$file"; done < "$backup/.missing"
fi
rm -rf -- "$backup"
echo 'Hard Gaming OS: Originaldateien wiederhergestellt (os-release, lsb-release, issue, GRUB, Plymouth).'
