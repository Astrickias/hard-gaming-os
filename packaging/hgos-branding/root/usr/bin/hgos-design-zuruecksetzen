#!/usr/bin/env bash
# Hard-Gaming-Design entfernen und Breeze Dark (KDE-Standard) setzen.
set -euo pipefail
[[ $(id -u) -ne 0 ]] || { echo 'Bitte als normaler Benutzer ausführen, nicht mit sudo.' >&2; exit 1; }
plasma-apply-lookandfeel -a org.kde.breezedark.desktop
plasma-apply-colorscheme BreezeDark
echo 'KDE-Standarddesign gesetzt. Hintergrundbild bitte in den Systemeinstellungen wählen.'
