// Hard Gaming OS – Standardkonfiguration für fastfetch.
// Eigene Anpassungen gehören nach ~/.config/fastfetch/config.jsonc.
{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "file",
    "source": "/usr/share/hard-gaming-os/fastfetch-logo.txt",
    "color": { "1": "white", "2": "38;2;84;239;97" },
    "padding": { "right": 3 }
  },
  "display": { "color": { "keys": "38;2;84;239;97" } },
  "modules": [
    "title", "separator", "os", "kernel", "uptime", "packages", "shell",
    "display", "de", "wm", "theme", "icons", "terminal", "cpu", "gpu",
    "memory", "disk", "localip", "locale", "break", "colors"
  ]
}
