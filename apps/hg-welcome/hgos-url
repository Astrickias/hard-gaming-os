#!/usr/bin/env bash
# Verarbeitet hgos://-Links aus Hello Hard Gaming OS.
case "${1:-}" in
  hgos://install*|hgos:install*)
    exec /usr/local/bin/hgos-install ;;
  hgos://update*|hgos:update*)
    command -v hgos-update-center >/dev/null && exec hgos-update-center
    exec konsole --hide-menubar -p tabtitle="Hard Gaming OS aktualisieren" -e bash -c \
      'echo "Hard Gaming OS wird aktualisiert …"; echo; sudo pacman -Syu; echo; read -rp "Fertig. Enter zum Schließen …"' ;;
  hgos://design*|hgos:design*)
    if hgos-design-anwenden; then
      notify-send -i /usr/share/hard-gaming-os/hg-os-logo.png "Hard Gaming OS" "Hard-Gaming-Design übernommen."
    else
      notify-send "Hard Gaming OS" "Design konnte nicht übernommen werden."
    fi ;;
  hgos://settings*|hgos:settings*)
    exec systemsettings ;;
  hgos://app/heroic*)
    command -v gtk-launch >/dev/null && gtk-launch heroic && exit 0
    exec heroic ;;
  hgos://app/lutris*)
    command -v gtk-launch >/dev/null && gtk-launch net.lutris.Lutris && exit 0
    exec lutris ;;
  *)
    echo "Unbekannte Aktion: ${1:-}" >&2; exit 2 ;;
esac
