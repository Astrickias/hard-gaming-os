#!/usr/bin/env bash
# Startet Hello Hard Gaming OS als eigene App (Qt Quick). Ohne Qt-QML-Laufzeit
# fällt es auf die HTML-Version im Browser zurück.
DIR=/usr/share/hard-gaming-os/welcome
ARGS=()
[[ -x /usr/local/bin/calamares-online.sh ]] && ARGS+=(--live)
for runtime in /usr/lib/qt6/bin/qml /usr/bin/qml6; do
  [[ -x "$runtime" ]] && exec "$runtime" "$DIR/qml/Main.qml" -- "${ARGS[@]}"
done
command -v firefox >/dev/null && exec firefox --new-window "file://$DIR/index.html"
exec xdg-open "file://$DIR/index.html"
